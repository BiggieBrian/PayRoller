              value={editData.system_deduction || 0} 
              onChange={e => setEditData({...editData, system_deduction: e.target.value})}
            />
          </div>
          <div>
            <label className="text-slate-400 block mb-0.5">Shorts</label>
            <input 
              type="number" 
