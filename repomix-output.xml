@import "tailwindcss";

/* Theme tokens: swapping these later gives us the light theme for free */
:root {
  --bg: #09090b;
  --surface: #121214;
  --surface-2: #17171a;
  --line: #1f1f23;
  --text: #e4e4e7;
  --muted: #a1a1aa;
}

@theme inline {
  --font-sans: "Google Sans Flex", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Google Sans Flex", ui-sans-serif, system-ui, sans-serif;
  --color-bg: var(--bg);
  --color-surface: var(--surface);
  --color-surface-2: var(--surface-2);
  --color-line: var(--line);
}

body {
  font-family: var(--font-sans);
  background: var(--bg);
  color: var(--text);
  font-feature-settings: "tnum" 1; /* aligned digits in salary columns */
}

@layer components {
  /* Standard card: replaces the repeated bg-[#121214] border border-[#1f1f23] */
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1rem;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04), 0 8px 24px -12px rgb(0 0 0 / 0.6);
  }
  .card-hover {
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .card-hover:hover {
    transform: translateY(-2px);
    border-color: #2f2f36;
  }

  /* Soft emerald glow for hero areas */
  .glow {
    position: relative;
    isolation: isolate;
  }
  .glow::before {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(60% 80% at 20% 0%, rgb(16 185 129 / 0.18), transparent 70%);
    pointer-events: none;
  }

  /* Friendlier letterforms using Flex's roundness axis */
  .rond {
    font-variation-settings: "ROND" 60;
  }
  /* Big display numbers */
  .display-num {
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variation-settings: "ROND" 40;
  }
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: none; }
}
.fade-up { animation: fade-up 0.4s ease both; }

@media (prefers-reduced-motion: reduce) {
  .fade-up, .card-hover { animation: none; transition: none; }
}
